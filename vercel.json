{
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,admissions.db}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!static/|public/).*)",
      "destination": "/api/index.py"
    }
  ]
}
